import { defineProperties } from "figma:react";
import {
  useRive,
  useViewModel,
  useViewModelInstance,
  useViewModelInstanceString,
} from "@rive-app/react-canvas";
import { useEffect } from "react";

export default function RiveComponent({
  riveFileUrl = "https://lucartoones.github.io/figma-rive-test/rive_test_file.riv",
  stateMachineName = "StateMachine",
  viewModelName = "ViewModel1",
  textPropertyPath = "designername",
  textValue = "Lucas Corrêa",
}) {
  const { rive, RiveComponent: RiveCanvas } = useRive({
    src: riveFileUrl,
    stateMachine: stateMachineName,
    autoplay: true,
    autoBind: false,
  });
  const viewModel = useViewModel(rive, { name: viewModelName });
  const viewModelInstance = useViewModelInstance(viewModel, { rive });
  const { setValue: setText } = useViewModelInstanceString(textPropertyPath, viewModelInstance);

  useEffect(() => {
    if (setText && textValue) setText(textValue);
  }, [setText, textValue]);

  return <RiveCanvas style={{ width: "100%", height: "100%" }} />;
}

defineProperties(RiveComponent, {
  riveFileUrl: { label: "Rive File URL", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/rive_test_file.riv" },
  stateMachineName: { label: "State Machine Name", type: "string", defaultValue: "StateMachine" },
  viewModelName: { label: "View Model Name", type: "string", defaultValue: "ViewModel1" },
  textPropertyPath: { label: "Property Name", type: "string", defaultValue: "designername" },
  textValue: { label: "Text Value (from CMS)", type: "string", defaultValue: "Lucas Corrêa" },
});
