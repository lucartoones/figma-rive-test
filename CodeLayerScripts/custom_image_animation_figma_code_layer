import { defineProperties } from "figma:react";
import {
  useRive,
  useViewModel,
  useViewModelInstance,
  useViewModelInstanceColor,
  useViewModelInstanceImage,
} from "@rive-app/react-canvas";
import * as RiveCore from "@rive-app/canvas";
import { useEffect } from "react";

// O bundler do Figma às vezes expõe o pacote só em `default`
const decodeImage = RiveCore.decodeImage ?? RiveCore.default?.decodeImage;
const ASSETS = "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta";

function useRiveImage(path, url, viewModelInstance) {
  const { setValue: setImage } = useViewModelInstanceImage(path, viewModelInstance);

  useEffect(() => {
    if (!setImage || !url || !decodeImage) return;
    let active = true;
    fetch(url)
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.arrayBuffer();
      })
      .then((buffer) => decodeImage(new Uint8Array(buffer)))
      .then((image) => {
        if (active) setImage(image);
        image.unref();
      })
      .catch((err) => console.error(`❌ Erro ao carregar ${path}:`, err));
    return () => {
      active = false;
    };
  }, [setImage, url]);
}

export default function RiveImageColorComponent({
  riveFileUrl = "https://lucartoones.github.io/figma-rive-test/RiveAnimations/custom_image_animation.riv",
  stateMachineName = "State Machine 1",
  viewModelName = "ViewModel1",
  imagePropertyPrefix = "placeholder",
  imageUrl1 = `${ASSETS}/fanta1.png`,
  imageUrl2 = `${ASSETS}/fanta2.png`,
  imageUrl3 = `${ASSETS}/fanta3.png`,
  imageUrl4 = `${ASSETS}/fanta4.png`,
  imageUrl5 = `${ASSETS}/fanta5.png`,
  imageUrl6 = `${ASSETS}/fanta6.png`,
  imageUrl7 = `${ASSETS}/fanta7.png`,
  imageUrl8 = `${ASSETS}/fanta8.png`,
  colorPropertyPath = "backgroundcolor",
  colorHex = "#000000",
}) {
  const { rive, RiveComponent: RiveCanvas } = useRive({
    src: riveFileUrl,
    stateMachines: stateMachineName,
    autoplay: true,
    autoBind: false,
  });
  const viewModel = useViewModel(rive, { name: viewModelName });
  const viewModelInstance = useViewModelInstance(viewModel, { rive });
  const { setRgb } = useViewModelInstanceColor(colorPropertyPath, viewModelInstance);

  // Lista de tamanho fixo, então a ordem dos hooks não muda entre renders
  [imageUrl1, imageUrl2, imageUrl3, imageUrl4, imageUrl5, imageUrl6, imageUrl7, imageUrl8].forEach((url, i) =>
    useRiveImage(`${imagePropertyPrefix}${i + 1}`, url, viewModelInstance)
  );

  useEffect(() => {
    const rgb = colorHex?.match(/^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
    if (setRgb && rgb) setRgb(...rgb.slice(1).map((h) => parseInt(h, 16)));
  }, [setRgb, colorHex]);

  return <RiveCanvas style={{ width: "100%", height: "100%" }} />;
}

defineProperties(RiveImageColorComponent, {
  riveFileUrl: { label: "Rive File URL", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/RiveAnimations/custom_image_animation.riv" },
  stateMachineName: { label: "State Machine", type: "string", defaultValue: "State Machine 1" },
  viewModelName: { label: "View Model Name", type: "string", defaultValue: "ViewModel1" },
  imagePropertyPrefix: { label: "Image Property Prefix (Rive)", type: "string", defaultValue: "placeholder" },
  imageUrl1: { label: "Image URL 1", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta1.png" },
  imageUrl2: { label: "Image URL 2", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta2.png" },
  imageUrl3: { label: "Image URL 3", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta3.png" },
  imageUrl4: { label: "Image URL 4", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta4.png" },
  imageUrl5: { label: "Image URL 5", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta5.png" },
  imageUrl6: { label: "Image URL 6", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta6.png" },
  imageUrl7: { label: "Image URL 7", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta7.png" },
  imageUrl8: { label: "Image URL 8", type: "string", defaultValue: "https://lucartoones.github.io/figma-rive-test/Assets/WantaFanta/fanta8.png" },
  colorPropertyPath: { label: "Color Property (Rive)", type: "string", defaultValue: "backgroundcolor" },
  colorHex: { label: "Color (HEX)", type: "string", defaultValue: "#000000" },
});
